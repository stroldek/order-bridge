{
  "manifest_version": 3,
  "name": "Order Bridge",
  "version": "0.2.1",
  "description": "Monitors GOST orders and prepares normalized order data for external integrations.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://gost.ua/*",
    "https://api.gost.ua/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Order Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gost.ua/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gost.ua/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
